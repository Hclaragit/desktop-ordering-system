# The code reads these as environment variables. It does NOT load this file
# automatically, so export them in your shell before running, e.g.
#   export SPREADSHEET_ID=...

# ID of the Google Sheet used as the data store (the part of the sheet URL after /d/)
SPREADSHEET_ID=

# Path to the Google OAuth client file (defaults to credentials.json in the working directory)
GOOGLE_CREDENTIALS_FILE=credentials.json

# Gmail account and app password used to send order confirmation emails.
# If either is empty, the app skips sending the email.
SHOP_EMAIL=
SHOP_EMAIL_APP_PASSWORD=
